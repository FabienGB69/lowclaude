# ============================================================
# EAD-France — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs réelles.
# NE JAMAIS committer .env dans le dépôt.
# ============================================================

# --- Firecrawl (source primaire : rendu JS + interception réseau) ---
FIRECRAWL_API_KEY=fc-your-api-key-here

# --- Supabase (stockage cible) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Google Places API (enrichissement : note, avis, horaires) ---
GOOGLE_PLACES_API_KEY=AIza...

# --- Garde-fou scraping ---
# SCRAPE_DRY_RUN=true  → collecte sans écrire (défaut)
# SCRAPE_DRY_RUN=false → écriture effective dans data/raw_centers.json
#                        À ne basculer qu'après validation humaine.
SCRAPE_DRY_RUN=true
